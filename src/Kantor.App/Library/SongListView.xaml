<UserControl x:Class="Kantor.App.Library.SongListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:Kantor.App.Pixel"
             xmlns:lib="clr-namespace:Kantor.App.Library"
             xmlns:video="clr-namespace:Kantor.App.Video"
             Focusable="False">
    <UserControl.Resources>
        <lib:CoverConverter x:Key="Thumb" DecodeWidth="200" />
        <lib:CoverConverter x:Key="GridThumb" DecodeWidth="360" />
        <BooleanToVisibilityConverter x:Key="VideoFlag" />

        <!-- Barra de desplazamiento pixel del tema (PixelScrollBar) para los visores de esta pantalla -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}" />

        <!-- Fila de la lista: marco escalonado; seleccionada = borde dorado -->
        <Style x:Key="SongRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <pixel:PixelFrame x:Name="Frame" Fill="{StaticResource PanelBrush}" BorderBrush="#3A4380"
                                          Shadow="{StaticResource InkBrush}" NotchUnits="2" BorderUnits="1"
                                          Padding="8,6,12,6">
                            <ContentPresenter />
                        </pixel:PixelFrame>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="Frame" Property="BorderUnits" Value="2" />
                                <Setter TargetName="Frame" Property="Shadow" Value="#C79A1A" />
                                <Setter TargetName="Frame" Property="Fill" Value="#34408A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource P1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Celda de la grilla -->
        <DataTemplate x:Key="GridCellTemplate" DataType="{x:Type lib:GridCell}">
            <pixel:PixelFrame x:Name="Cell" Margin="0,0,10,10" Fill="{StaticResource PanelBrush}" BorderBrush="#3A4380"
                              Shadow="{StaticResource InkBrush}" NotchUnits="2" BorderUnits="1" Padding="6"
                              MouseLeftButtonDown="OnCellMouseDown"
                              ToolTip="{Binding Song.Title}">
                <StackPanel Background="Transparent">
                    <Border Background="#1B1040" Height="150">
                        <Grid>
                            <Image Source="{Binding Song.CoverPath, Converter={StaticResource GridThumb}}"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="▶" Foreground="{StaticResource GoldBrush}" FontSize="20" Margin="6,4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Visibility="{Binding Song.HasVideo, Converter={StaticResource VideoFlag}}" />
                            <Border Background="#CC070A24" Padding="6,0" Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding Song.IsDuet, Converter={StaticResource VideoFlag}}">
                                <TextBlock Text="{Binding DuetLabel, RelativeSource={RelativeSource AncestorType=lib:SongListView}}"
                                           Foreground="{StaticResource P1Brush}" FontFamily="{StaticResource PixelFont}" FontSize="22" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Song.Title}" Margin="0,6,0,0" FontFamily="{StaticResource PixelFont}"
                               FontSize="26" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Song.Artist}" FontFamily="{StaticResource PixelFont}" FontSize="20"
                               Foreground="#9AA3D6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </pixel:PixelFrame>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="Cell" Property="BorderUnits" Value="2" />
                    <Setter TargetName="Cell" Property="Shadow" Value="#C79A1A" />
                    <Setter TargetName="Cell" Property="Fill" Value="#34408A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#070A24">
        <pixel:PixelBackdrop x:Name="Backdrop" />

        <pixel:PixelViewbox>
            <Grid Width="1280" Height="720">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="400" />
                </Grid.ColumnDefinitions>

                <!-- Título, vista y contador -->
                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="40,22,40,0">
                    <Button x:Name="QueueButton" DockPanel.Dock="Right" Style="{StaticResource PixelButton}" FontSize="22"
                            Margin="0,0,24,0" VerticalAlignment="Bottom" Click="OnQueueClick" Focusable="False" />
                    <Button x:Name="QueueAddButton" DockPanel.Dock="Right" Style="{StaticResource PixelButton}" FontSize="22"
                            Margin="0,0,24,0" VerticalAlignment="Bottom" Click="OnQueueAddClick" Focusable="False" />
                    <Button x:Name="SessionButton" DockPanel.Dock="Right" Style="{StaticResource PixelButton}" FontSize="22"
                            Margin="0,0,24,0" VerticalAlignment="Bottom" Click="OnSessionClick" Focusable="False" />
                    <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource PixelButton}" FontSize="22"
                            Margin="0,0,24,0" VerticalAlignment="Bottom" Click="OnBackClick" Focusable="False" />
                    <Button x:Name="ViewToggle" DockPanel.Dock="Right" Style="{StaticResource PixelButton}" FontSize="22"
                            Margin="0,0,24,0" VerticalAlignment="Bottom" Click="OnViewToggleClick" Focusable="False" />
                    <pixel:PixelText x:Name="TitleText" FontFamily="{StaticResource PixelFont}" FontSize="56"
                                     Foreground="{StaticResource GoldBrush}" Outline="{StaticResource InkBrush}"
                                     OutlineSize="4" Shadow="{StaticResource InkBrush}" ShadowOffset="4" />
                </DockPanel>

                <!-- Buscador -->
                <pixel:PixelFrame Grid.Row="1" Grid.ColumnSpan="2" Margin="40,14,40,14" Fill="#0A0D22"
                                  BorderBrush="{StaticResource P1Brush}" Shadow="{StaticResource InkBrush}"
                                  NotchUnits="2" BorderUnits="1" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- El contador vive en el buscador: en la cabecera competía con el título por el ancho -->
                        <pixel:PixelText x:Name="CountText" Grid.Column="1" Margin="16,0,0,0"
                                         FontFamily="{StaticResource PixelFont}" FontSize="28"
                                         Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Placeholder" FontFamily="{StaticResource PixelFont}" FontSize="34"
                                   Foreground="#5E6693" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource GoldBrush}"
                                 FontFamily="{StaticResource PixelFont}" FontSize="34" VerticalContentAlignment="Center"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </pixel:PixelFrame>

                <!-- Lista -->
                <ListBox x:Name="Songs" Grid.Row="2" Grid.Column="0" Margin="40,0,0,0" Padding="0,0,0,12" Background="Transparent"
                         BorderThickness="0" ItemContainerStyle="{StaticResource SongRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnSongDoubleClick" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="68">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#1B1040" Margin="0,0,12,0">
                                    <Image Source="{Binding CoverPath, Converter={StaticResource Thumb}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource PixelFont}" FontSize="34"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontFamily="{StaticResource PixelFont}" FontSize="25"
                                               Foreground="#9AA3D6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DuetLabel, RelativeSource={RelativeSource AncestorType=lib:SongListView}}"
                                               Foreground="{StaticResource P1Brush}" FontFamily="{StaticResource PixelFont}"
                                               FontSize="24" Margin="0,0,12,0"
                                               Visibility="{Binding IsDuet, Converter={StaticResource VideoFlag}}" />
                                    <TextBlock Text="▶" Foreground="{StaticResource GoldBrush}" FontSize="20"
                                               Visibility="{Binding HasVideo, Converter={StaticResource VideoFlag}}"
                                               ToolTip="Tiene video" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Grilla (filas de seis celdas; solo las visibles se crean) -->
                <ListBox x:Name="GridRows" Grid.Row="2" Grid.Column="0" Margin="40,0,0,0" Padding="0,0,0,12"
                         Background="Transparent" BorderThickness="0" Visibility="Collapsed" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource GridCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="{x:Static lib:SongListView.GridColumns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Detalle (solo en la vista de lista) -->
                <Grid Grid.Row="2" Grid.Column="1" Margin="14,0,40,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <pixel:PixelFrame x:Name="DetailFrame" Margin="0,0,0,10"
                                  Fill="{StaticResource PanelBrush}" BorderBrush="{StaticResource P2Brush}"
                                  Shadow="{StaticResource InkBrush}" NotchUnits="3" BorderUnits="1" Padding="16">
                    <StackPanel x:Name="Detail">
                        <Border Background="#1B1040" Width="180" Height="180" HorizontalAlignment="Center">
                            <Grid>
                                <Image x:Name="BigCoverImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- Vista previa en video: aparece sobre la carátula cuando llega el primer cuadro -->
                                <video:VideoBackground x:Name="PreviewVideo" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DetailTitle" Margin="0,14,0,0" FontFamily="{StaticResource PixelFont}"
                                   FontSize="38" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailArtist" FontFamily="{StaticResource PixelFont}" FontSize="28"
                                   Foreground="#9AA3D6" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailMeta" Margin="0,8,0,0" FontFamily="{StaticResource PixelFont}" FontSize="22"
                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <pixel:PixelText x:Name="DuetBadge" Margin="0,0,16,0" FontFamily="{StaticResource PixelFont}"
                                             FontSize="24" Foreground="{StaticResource P1Brush}" />
                            <pixel:PixelText x:Name="VideoBadge" FontFamily="{StaticResource PixelFont}"
                                             FontSize="24" Foreground="{StaticResource GoldBrush}" />
                        </StackPanel>
                    </StackPanel>
                </pixel:PixelFrame>

                <!-- QR de invitados: chico, debajo de la ficha -->
                <Border x:Name="GuestHost" x:FieldModifier="public" Grid.Row="1" HorizontalAlignment="Stretch" />
                </Grid>

                <!-- Mensaje vacío / progreso -->
                <pixel:PixelText x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="2" FontFamily="{StaticResource PixelFont}"
                                 FontSize="40" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />

                <Button x:Name="FoldersButton" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PixelButton}"
                        FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,110,0,0"
                        Visibility="Collapsed" Click="OnFoldersClick" Focusable="False" />

                <pixel:PixelText x:Name="HintText" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="{StaticResource PixelFont}"
                                 FontSize="26" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                 Margin="0,8,0,16" />
            </Grid>
        </pixel:PixelViewbox>
    </Grid>
</UserControl>
