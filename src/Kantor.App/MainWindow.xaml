<Window x:Class="Kantor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stage="clr-namespace:Kantor.App.Stage"
        xmlns:results="clr-namespace:Kantor.App.Results"
        xmlns:menu="clr-namespace:Kantor.App.Menu"
        xmlns:queue="clr-namespace:Kantor.App.Queue"
        xmlns:library="clr-namespace:Kantor.App.Library"
        xmlns:options="clr-namespace:Kantor.App.Options"
        xmlns:players="clr-namespace:Kantor.App.Players"
        xmlns:video="clr-namespace:Kantor.App.Video"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kantor" Width="1280" Height="720" MinWidth="640" MinHeight="400"
        Background="#070A24" Foreground="#F0F0F0"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseMove="OnWindowMouseMove"
        PreviewMouseDown="OnWindowMouseDown" UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged" LocationChanged="OnWindowLocationChanged"
        DpiChanged="OnWindowDpiChanged">
    <!-- Barra de título propia: WindowChrome conserva redimensionar, ajustar a bordes y sombra de Windows -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome" CaptionHeight="38" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="#070A24">
            <Border BorderBrush="#2A3370" BorderThickness="0,0,0,2" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                <Image Source="/Assets/Branding/kantor-logo.png" Height="26" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource PixelFont}" FontSize="24" Foreground="{StaticResource DimBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="FullscreenButton" Style="{StaticResource TitleButton}" Click="OnFullscreenClick"
                        Content="&#xE740;" ToolTip="Pantalla completa (F11)" />
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" Click="OnMinimizeClick"
                        Content="&#xE921;" ToolTip="Minimizar" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Click="OnMaximizeClick"
                        Content="&#xE922;" ToolTip="Maximizar" />
                <Button x:Name="CloseButton" Style="{StaticResource TitleCloseButton}" Click="OnCloseClick"
                        Content="&#xE8BB;" ToolTip="Cerrar" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Barra de herramientas: ya no se muestra (el escenario ocupa todo). Los controles quedan en el árbol porque
            guardan el estado de dificultad, retardo, voz e idioma; todo se maneja desde Opciones, Jugadores y teclas.
        -->
        <DockPanel x:Name="Toolbar" Grid.Row="0" Margin="12,10,12,6" Visibility="Collapsed">
            <Button x:Name="OpenButton" Content="Abrir… (Ctrl+O)" Padding="14,6" Click="OnOpenClick" />
            <Button x:Name="PlayButton" Content="Reproducir (Espacio)" Padding="14,6" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnPlayPauseClick" />
            <Button x:Name="StopButton" Content="Detener" Padding="14,6" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnStopClick" />
            <Button Content="Jugadores…" Padding="14,6" Margin="8,0,0,0" Click="OnPlayersToolbarClick"
                    ToolTip="Jugadores, partida e historial (detiene la canción)." />
            <Button Content="Opciones… (Ctrl+I)" Padding="14,6" Margin="8,0,0,0" Click="OnInputsClick"
                    ToolTip="Audio, micrófonos, biblioteca, juego y pantalla (detiene la canción)." />
            <Button Content="Menú" Padding="14,6" Margin="8,0,0,0" Click="OnMenuClick"
                    ToolTip="Vuelve al menú principal (detiene la canción)." />
            <TextBlock Text="Dificultad" VerticalAlignment="Center" Foreground="#8A919E" Margin="16,0,6,0" />
            <ComboBox x:Name="DifficultyBox" Width="90" SelectedIndex="0" VerticalContentAlignment="Center"
                      SelectionChanged="OnDifficultyChanged"
                      ToolTip="Fácil: 2 semitonos de tolerancia · Medio: 1 · Difícil: tono exacto. Solo se cambia con la canción detenida.">
                <ComboBoxItem Content="Fácil" />
                <ComboBoxItem Content="Medio" />
                <ComboBoxItem Content="Difícil" />
            </ComboBox>
            <TextBlock Text="Retardo" VerticalAlignment="Center" Foreground="#8A919E" Margin="16,0,6,0" />
            <ComboBox x:Name="DelayBox" Width="80" SelectedIndex="7" VerticalContentAlignment="Center"
                      SelectionChanged="OnDelayChanged"
                      ToolTip="Retardo de voz: cuánto después de lo que suena llega tu voz (aire, reacción y latencia de audio). Se compara tu voz con ese desfase. Solo se cambia con la canción detenida.">
                <ComboBoxItem Content="0 ms" />
                <ComboBoxItem Content="25 ms" />
                <ComboBoxItem Content="50 ms" />
                <ComboBoxItem Content="75 ms" />
                <ComboBoxItem Content="100 ms" />
                <ComboBoxItem Content="125 ms" />
                <ComboBoxItem Content="150 ms" />
                <ComboBoxItem Content="175 ms" />
                <ComboBoxItem Content="200 ms" />
                <ComboBoxItem Content="225 ms" />
                <ComboBoxItem Content="250 ms" />
                <ComboBoxItem Content="275 ms" />
                <ComboBoxItem Content="300 ms" />
            </ComboBox>
            <Button x:Name="CalibrateButton" Content="Calibrar…" Padding="10,4" Margin="6,0,0,0"
                    Click="OnCalibrateClick"
                    ToolTip="Mide la latencia de audio de este equipo con una señal de prueba y sugiere el retardo de voz." />
            <TextBlock Text="Voz" VerticalAlignment="Center" Foreground="#8A919E" Margin="16,0,6,0" />
            <ComboBox x:Name="DisplayBox" Width="90" SelectedIndex="0" VerticalContentAlignment="Center"
                      SelectionChanged="OnDisplayChanged"
                      ToolTip="Por beat: como UltraStar (barras sobre la nota si acertás). Cruda: cada análisis del detector.">
                <ComboBoxItem Content="Por beat" />
                <ComboBoxItem Content="Cruda" />
            </ComboBox>
            <TextBlock Text="Comentarios" VerticalAlignment="Center" Foreground="#8A919E" Margin="16,0,6,0" />
            <ComboBox x:Name="LanguageBox" Width="90" SelectedIndex="0" VerticalContentAlignment="Center"
                      SelectionChanged="OnLanguageChanged"
                      ToolTip="Idioma de los comentarios del resultado.">
                <ComboBoxItem Content="Español" Tag="es" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <TextBlock x:Name="ScoreText" DockPanel.Dock="Right" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0" Text="0" />
            <TextBlock Text="Puntos" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8A919E"
                       Margin="16,0,0,0" />
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="16"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <video:VideoBackground x:Name="Video" Grid.Row="1" />

        <stage:StageControl x:Name="Stage" Grid.Row="1" />

        <!-- Controles del escenario para el mouse: aparecen al moverlo (y mientras la canción no suena) -->
        <StackPanel x:Name="StageControls" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,0,20,40" Visibility="Collapsed">
            <Button x:Name="StageFinishButton" Style="{StaticResource PixelButton}" FontSize="22" Margin="0,0,12,0"
                    Click="OnStageFinishClick" Visibility="Collapsed" />
            <Button x:Name="StagePauseButton" Style="{StaticResource PixelButton}" FontSize="22" Margin="0,0,12,0"
                    Click="OnStagePauseClick" />
            <Button x:Name="StageMenuButton" Style="{StaticResource PixelButton}" FontSize="22"
                    Click="OnStageMenuClick" />
        </StackPanel>

        <results:ResultsView x:Name="Results" Grid.Row="1" Visibility="Collapsed"
                             ReplayRequested="OnResultsReplay" CloseRequested="OnResultsClose"
                             NextRequested="OnResultsNext" />

        <!-- Menú principal: pantalla completa (cubre barra de herramientas y de estado) -->
        <menu:MainMenuView x:Name="Menu" Grid.Row="0" Grid.RowSpan="3"
                           SingRequested="OnMenuSing" PlayersRequested="OnMenuPlayers" OptionsRequested="OnMenuOptions"
                           ExitRequested="OnMenuExit" />

        <!-- Lista de canciones con buscador, sobre el menú -->
        <library:SongListView x:Name="SongList" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                              SongChosen="OnSongChosen" BackRequested="OnSongListBack" SessionRequested="OnSongListSession" QueueAddRequested="OnQueueAdd" QueueRequested="OnQueueOpen" FoldersRequested="OnSongListFolders"
                              ViewModeChanged="OnSongListViewMode" />

        <!-- Cola de canciones -->
        <queue:QueueView x:Name="QueueScreen" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                         BackRequested="OnQueueBack" SingRequested="OnQueueSing" />

        <!-- Opciones: audio, biblioteca, juego y pantalla; sobre todo lo demás -->
        <options:OptionsView x:Name="Options" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" />

        <!-- Jugadores, sesión e historial -->
        <players:PlayersView x:Name="PlayersScreen" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" />

        <!-- Aviso de sesión abierta al arrancar -->
        <players:SessionPromptView x:Name="SessionPrompt" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                                   ContinueRequested="OnSessionContinue" NewRequested="OnSessionNew"
                                   FreeRequested="OnSessionFree" CancelRequested="OnSessionCancel" />

        <!-- Cartel de carga: la canción se lee y decodifica en segundo plano -->
        <Grid x:Name="LoadingLayer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#A0050718">
            <TextBlock x:Name="LoadingText" FontFamily="{StaticResource PixelFont}" FontSize="64"
                       Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Barra técnica (entrada, motor, estado): oculta por defecto; F9 la muestra o la oculta -->
        <DockPanel x:Name="StatusBar" Grid.Row="2" Margin="12,6,12,8" Visibility="Collapsed">
            <TextBlock x:Name="InputText" DockPanel.Dock="Right" Foreground="#8A919E" Margin="16,0,0,0" />
            <TextBlock x:Name="StatusText" Foreground="#8A919E" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        </Grid>
    </Grid>
</Window>
