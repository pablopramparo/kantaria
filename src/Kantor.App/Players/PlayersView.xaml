<UserControl x:Class="Kantor.App.Players.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:Kantor.App.Pixel"
             Focusable="False">
    <Grid Background="#070A24">
        <pixel:PixelBackdrop />

        <!-- Composición de 1280 × 720 que escala con la ventana, como el menú y las opciones -->
        <pixel:PixelViewbox>
            <Grid Width="1280" Height="720">
                <pixel:PixelText x:Name="TitleText" FontFamily="{StaticResource PixelFont}" FontSize="64"
                                 Foreground="{StaticResource GoldBrush}" Shadow="{StaticResource InkBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,24,0,0" />

                <Button x:Name="BackButton" Style="{StaticResource PixelButton}" FontSize="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,60,0" Click="OnBackClick" />

                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="60,104,0,0" />

                <pixel:PixelFrame Fill="#CC10142E" BorderBrush="{StaticResource P1Brush}"
                                  Shadow="{StaticResource InkBrush}" BorderUnits="1" NotchUnits="2" ShadowUnits="1"
                                  Margin="60,176,60,64" Padding="24,18">
                    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="ContentPanel" Margin="0,0,14,0"
                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                </pixel:PixelFrame>

                <pixel:PixelText x:Name="HintText" FontFamily="{StaticResource PixelFont}" FontSize="24"
                                 Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom" Margin="0,0,0,18" />

                <!-- Modal: elegir el jugador de un micrófono (retrato + nombre). Tapa y deshabilita lo de abajo. -->
                <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#D0050718">
                    <pixel:PixelFrame Fill="#F010142E" BorderBrush="{StaticResource GoldBrush}"
                                      Shadow="{StaticResource InkBrush}" BorderUnits="1" NotchUnits="2" ShadowUnits="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MinWidth="560" MaxWidth="1000" Padding="32,26">
                        <StackPanel x:Name="ModalPanel"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    KeyboardNavigation.TabNavigation="Cycle" />
                    </pixel:PixelFrame>
                </Grid>

                <!-- Grilla de avatares: dentro de la composición, encima de todo, para no salirse de la ventana. -->
                <Grid x:Name="FaceLayer" Visibility="Collapsed" Background="#D0050718">
                    <pixel:PixelFrame Fill="#F010142E" BorderBrush="{StaticResource GoldBrush}"
                                      Shadow="{StaticResource InkBrush}" BorderUnits="1" NotchUnits="2" ShadowUnits="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MaxWidth="1120" Margin="40" Padding="24,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="FaceCloseButton" Content="X" Style="{StaticResource PixelTileButton}"
                                    FontSize="22" MinWidth="44" Padding="12,4" HorizontalAlignment="Right"
                                    Margin="0,0,0,10" Click="OnFaceCloseClick" />
                            <ScrollViewer x:Name="FaceScroll" Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}" />
                                </ScrollViewer.Resources>
                                <WrapPanel x:Name="FacePanel" HorizontalAlignment="Center"
                                           KeyboardNavigation.DirectionalNavigation="Cycle"
                                           KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </Grid>
                    </pixel:PixelFrame>
                </Grid>
            </Grid>
        </pixel:PixelViewbox>
    </Grid>
</UserControl>
