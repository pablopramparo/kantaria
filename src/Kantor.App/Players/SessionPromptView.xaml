<UserControl x:Class="Kantor.App.Players.SessionPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:Kantor.App.Pixel"
             Focusable="False">
    <Grid Background="#B0070A24">
        <pixel:PixelViewbox>
            <Grid Width="1280" Height="720">
                <pixel:PixelFrame Fill="#F010142E" BorderBrush="{StaticResource GoldBrush}"
                                  Shadow="{StaticResource InkBrush}" BorderUnits="1" NotchUnits="2" ShadowUnits="1"
                                  Width="860" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Padding="36,28">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <pixel:PixelText x:Name="TitleText" FontFamily="{StaticResource PixelFont}" FontSize="48"
                                         Foreground="{StaticResource GoldBrush}" Shadow="{StaticResource InkBrush}"
                                         HorizontalAlignment="Center" />
                        <TextBlock x:Name="InfoText" FontFamily="{StaticResource BodyFont}" FontSize="20"
                                   Foreground="{StaticResource TextBrush}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,18,0,4" />
                        <TextBlock x:Name="PlayersText" FontFamily="{StaticResource PixelFont}" FontSize="28"
                                   Foreground="{StaticResource P1Brush}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,18" />
                        <Button x:Name="ContinueButton" Style="{StaticResource PixelButton}" FontSize="32" Width="560"
                                Click="OnContinue" />
                        <Button x:Name="NewButton" Style="{StaticResource PixelButton}" FontSize="32" Width="560"
                                Margin="0,14,0,0" Click="OnNew" />
                        <Button x:Name="FreeButton" Style="{StaticResource PixelButton}" FontSize="32" Width="560"
                                Margin="0,14,0,0" Click="OnFree" />
                        <Button x:Name="BackButton" Style="{StaticResource PixelButton}" FontSize="24" Width="560"
                                Margin="0,14,0,0" Click="OnBack" />
                        <TextBlock x:Name="HintText" FontFamily="{StaticResource BodyFont}" FontSize="15"
                                   Foreground="{StaticResource DimBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </pixel:PixelFrame>
            </Grid>
        </pixel:PixelViewbox>
    </Grid>
</UserControl>
