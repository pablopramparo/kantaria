<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationIcon>Assets\Branding\kantaria.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kantor.Core\Kantor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jersey 15 (SIL OFL 1.1): ver Assets/Fonts/OFL.txt -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Characters\**\*.png" />
    <Resource Include="Assets\Branding\*.png" />
    <!-- Música de la interfaz (CC0, ver Assets/Music/README.md): se copia junto al ejecutable (compilación y publicación) -->
    <Content Include="Assets\Music\*.mp3;Assets\Music\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Edition=Local (por omisión: instalador y zip) o Edition=Store (Microsoft Store: sin los avatares de
         Kantor.Core/Characters/store-excluded.txt, que ni siquiera se embeben). Ver scripts/publish.ps1 -Edition. -->
    <Edition Condition="'$(Edition)' == ''">Local</Edition>
    <StoreExcludedText Condition="'$(Edition)' == 'Store'">$([MSBuild]::Unescape($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Kantor.Core\Characters\store-excluded.txt'))))</StoreExcludedText>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.4.0</Version>
    <Product>Kantaria</Product>
    <Copyright>Copyright (C) 2026 Pablo Pramparo</Copyright>
    <!-- Solo las cadenas de la propia aplicación: sin las carpetas de idiomas de las bibliotecas de WPF. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup Condition="'$(Edition)' == 'Store'">
    <_StoreExcluded Include="$(StoreExcludedText)" />
    <Resource Remove="@(_StoreExcluded->'Assets\Characters\%(Identity)\portrait.png')" />
    <Resource Remove="@(_StoreExcluded->'Assets\Characters\%(Identity)\fullbody.png')" />
  </ItemGroup>

  <!-- Distribución: solo x64. LibVLC trae x86 y x64 y las bibliotecas de enlace (.lib); no hacen falta. -->
  <Target Name="TrimLibVlcForDistribution" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86" />
    <ItemGroup>
      <_ImportLibs Include="$(PublishDir)libvlc\win-x64\*.lib" />
    </ItemGroup>
    <Delete Files="@(_ImportLibs)" />
  </Target>

</Project>
