<UserControl x:Class="Kantor.App.Guest.GuestAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:Kantor.App.Pixel"
             xmlns:guest="clr-namespace:Kantor.App.Guest"
             Focusable="False">
    <Grid Background="#070A24">
        <pixel:PixelBackdrop />

        <pixel:PixelViewbox>
            <Grid Width="1280" Height="720">
                <pixel:PixelText x:Name="TitleText" FontFamily="{StaticResource PixelFont}" FontSize="72"
                                 Foreground="{StaticResource GoldBrush}" Shadow="{StaticResource InkBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,22,0,0" />
                <Button x:Name="BackButton" Style="{StaticResource PixelButton}" FontSize="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,60,0" Click="OnBackClick" />

                <pixel:PixelFrame Fill="#E010142E" BorderBrush="{StaticResource P1Brush}"
                                  Shadow="{StaticResource InkBrush}" BorderUnits="1" NotchUnits="2" ShadowUnits="1"
                                  Margin="60,120,60,70" Padding="30,26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <guest:QrView x:Name="Qr" Side="400" />
                            <TextBlock x:Name="QrOff" Width="400" Height="400" TextWrapping="Wrap"
                                       TextAlignment="Center" FontFamily="{StaticResource PixelFont}" FontSize="34"
                                       Foreground="{StaticResource DimBrush}" Padding="30,150,30,0" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
                            <pixel:PixelText x:Name="StatusText" FontFamily="{StaticResource PixelFont}" FontSize="48" />
                            <TextBlock x:Name="ScanText" Margin="0,16,0,0" FontFamily="{StaticResource PixelFont}"
                                       FontSize="34" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="AddressText" Margin="0,18,0,0" FontFamily="{StaticResource PixelFont}"
                                       FontSize="34" Foreground="{StaticResource P1Brush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="NoteText" Margin="0,18,0,0" FontFamily="{StaticResource BodyFont}"
                                       FontSize="18" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" />
                            <Button x:Name="ToggleButton" Style="{StaticResource PixelButton}" FontSize="34"
                                    HorizontalAlignment="Left" Margin="0,26,0,0" MinWidth="280" Click="OnToggleClick" />
                        </StackPanel>
                    </Grid>
                </pixel:PixelFrame>

                <pixel:PixelText x:Name="HintText" FontFamily="{StaticResource PixelFont}" FontSize="24"
                                 Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom" Margin="0,0,0,18" />
            </Grid>
        </pixel:PixelViewbox>
    </Grid>
</UserControl>
